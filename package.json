{
  "name": "logcentis",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "author": "Douglas Brum <douglla.brum@gmail.com>",
  "scripts": {
    "start:dev": "node --import=tsx --watch src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc && tsup",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "db:migrate": "node --import=tsx src/cli/index.ts --migrate:latest",
    "db:rollback": "node --import=tsx src/cli/index.ts --migrate:down",
    "db:migrate:to": "node --import=tsx src/cli/index.ts --migrate:to",
    "db:current": "node --import=tsx src/cli/index.ts --migrate:current",
    "db:status": "node --import=tsx src/cli/index.ts --migrate:status",
    "db:types": "kysely-codegen  --camel-case --out-file src/types/db.ts --dialect postgres --url env(DB_URL_DEV)"
  },
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.24",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.27.0",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.18.5",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jose": "^6.0.11",
    "kysely": "^0.28.2",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.42"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "outDir": "dist",
    "format": [
      "esm",
      "cjs"
    ],
    "target": "es2020",
    "sourcemap": true,
    "clean": true,
    "dts": true,
    "splitting": false,
    "skipNodeModulesBundle": true
  }
}
